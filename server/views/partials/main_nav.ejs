            <a href="/logout" class="nav-link">
              <i class="fa fa-lg fa-sign-out-alt"></i> Logout
            </a>
          </li>

        <% } else { %>

        <!-- Logged-out State -->
        <li class="nav-item mx-2">
          <a href="/login" class="nav-link">
            <i class="fa fa-lg fa-sign-in-alt"></i> Login
          </a>
        </li>

        <% } %>

      </ul>
    </div>
  </div>
